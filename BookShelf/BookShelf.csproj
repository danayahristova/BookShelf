    <ImplicitUsings>enable</ImplicitUsings>
    <UserSecretsId>9f11bed4-242f-4a91-9678-3704cb5829d6</UserSecretsId>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.EntityFrameworkCore" Version="10.0.9" />
