@using Microsoft.AspNetCore.Mvc.Rendering
@model BookShelf.Data.Models.Book
@{
    ViewData["Title"] = "Create Book";
    var authors = ViewBag.Authors as List<SelectListItem> ?? new List<SelectListItem>();
}

<h1 class="mb-3">Create Book</h1>

<form asp-action="Create" method="post" class="row g-3">
    <div class="col-12">
        <label asp-for="@Model.Title" class="form-label"></label>
        <input asp-for="@Model.Title" class="form-control" />
        <span asp-validation-for="Title" class="text-danger"></span>
    </div>

    <div class="col-12 col-md-4">
        <label asp-for="@Model.Year" class="form-label"></label>
        <input asp-for="@Model.Year" class="form-control" />
        <span asp-validation-for="@Model.Year" class="text-danger"></span>
    </div>

    <div class="col-12 col-md-8">
        <label asp-for="@Model.AuthorId" class="form-label">Author</label>
        <select asp-for="@Model.AuthorId" class="form-select" asp-items="authors">
            <option value="">-- Select author --</option>
        </select>
        <span asp-validation-for="@Model.AuthorId" class="text-danger"></span>
    </div>

    <div class="col-12">
        <button type="submit" class="btn btn-success" asp-controller="Books" asp-action="Create">Save</button>
        <a class="btn btn-secondary" asp-controller="Books" asp-action="Index">Cancel</a>
    </div>
</form>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
