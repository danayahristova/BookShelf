
@{
    ViewData["Title"] = "Home";
}

<link rel="stylesheet" href="~/css/home.css" />

<div class="container py-5">
    <div class="text-center mb-5">
        <h1 class="display-3 fw-bold">📚 BookShelf</h1>
        <p class="lead text-muted">
            Manage your books and authors in one place.
        </p>
    </div>

    <div class="row justify-content-center mb-4">
        <div class="col-lg-6">
            <div class="card shadow home-card text-center">
                <div class="card-body">
                    <h2 class="card-title">Books</h2>
                    <p class="card-text">
                        Browse, edit, delete, or add books to your library.
                    </p>

                    <a asp-controller="Books"
                       asp-action="Index"
                       class="btn btn-primary me-2">
                        View Books
                    </a>

                    <a asp-controller="Books"
                       asp-action="Create"
                       class="btn btn-outline-primary">
                        Add Book
                    </a>
                </div>
            </div>
        </div>
    </div>

    <div class="row justify-content-center">
        <div class="col-lg-6">
            <div class="card shadow home-card text-center">
                <div class="card-body">
                    <h2 class="card-title">Authors</h2>
                    <p class="card-text">
                        View the authors in your library.
                    </p>

                    <a asp-controller="Authors"
                       asp-action="Index"
                       class="btn btn-success">
                        View Authors
                    </a>
                </div>
            </div>
        </div>
    </div>
</div>


